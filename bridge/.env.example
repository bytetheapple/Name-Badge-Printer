# Print bridge configuration.
# Copy this file to .env on the machine that runs the bridge (the Raspberry Pi).

SUPABASE_URL=https://xesgdkwwhszdtcgcdjjw.supabase.co

# The bootstrap credential, written when the card is imaged. Issue one in the
# admin under Print Server -> Print servers (platform admins only); it is shown
# once, so paste it here straight away.
#
# This value is temporary. The first time the device connects, the server
# retires it and hands over a replacement, which the bridge stores in
# bridge/token and uses from then on — renewing itself roughly every 90 days
# with nobody installing anything. Once that has happened this line is dead and
# can be removed.
#
# bridge/token is written by the bridge and by nothing else. Do not edit it, and
# do not copy it between devices: two machines sharing a credential will fight
# over rotation, and one will end up revoked.
BRIDGE_TOKEN=nbk_your-bridge-token

# DEPRECATED — the project-wide service_role key. It bypasses RLS entirely, so a
# device holding it can reach EVERY organization. Only used when BRIDGE_TOKEN is
# unset, so that an existing Pi can be upgraded and cut over in two steps.
# Delete this line once BRIDGE_TOKEN is working.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional tuning
POLL_INTERVAL_SECONDS=2
HEARTBEAT_INTERVAL_SECONDS=15

# Optional font overrides (otherwise sensible system fonts are auto-detected)
# FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

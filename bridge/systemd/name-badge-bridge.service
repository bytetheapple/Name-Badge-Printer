[Unit]
Description=Name Badge Print Bridge
After=network-online.target
Wants=network-online.target

# Give up after ten failed starts in five minutes and report `failed`, rather
# than retrying every five seconds for ever.
#
# Without this a device that can never start looks like one that is merely
# starting: `activating`, restart counter climbing, and in the console
# indistinguishable from a Pi that is switched off. One sat at 72,344 restarts
# for four days before anyone looked.
#
# Safe because the bridge does not exit on a bad network — it catches poll
# errors and carries on inside the same process. Exiting means something
# structural: a missing file, an unreadable credential, an import that fails.
# Those do not come right on their own, so continuing to retry only hides
# them. The updater's health check reads is-active, which a failed unit is
# not, so a bad version still reverts itself.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Its own account, deliberately not the one you log in with and not in the
# sudo group. A fault in the bridge, or a leaked bridge credential, then
# reaches an account that can do nothing but run this.
#
# The installer rewrites User, the paths, and StateDirectory to match the
# device; these are the development defaults.
User=nbkbridge
Group=nbkbridge
WorkingDirectory=/home/pi/name-badge-printer/bridge
ExecStart=/home/pi/name-badge-printer/bridge/venv/bin/python bridge.py
EnvironmentFile=/home/pi/name-badge-printer/bridge/.env

# The code is not the bridge's to write. Its credential and its image cache
# live here instead, which systemd creates and owns.
StateDirectory=name-badge-bridge
Environment=BRIDGE_STATE_DIR=/var/lib/name-badge-bridge

# Nothing this runs needs to gain privileges, and saying so blocks the setuid
# route out of an unprivileged account.
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=Check for a new print bridge version

[Timer]
# Every minute. A run that finds nothing to do is one local git rev-parse and
# one HTTPS call — the fetch only happens when there is actually a new version
# to move to — so the cost of asking often is close to nothing, and the benefit
# is that a release reaches a device while somebody is still watching for it.
#
# The jitter is deliberately well under the interval: a spread larger than the
# period does not stagger a fleet, it makes the period unpredictable. Raise
# both together if a larger fleet ever makes this worth metering.
OnBootSec=1min
OnUnitActiveSec=1min
RandomizedDelaySec=15s
Persistent=true

[Install]
WantedBy=timers.target
